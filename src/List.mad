import { toInteger } from "Float"
import { length, repeatWith, slice } from "List"
import Math from "Math"



cut :: Integer -> List a -> #[List a, List a]
export cut = (a, xs) => #[slice(0, a, xs), slice(a, length(xs), xs)]

segment :: Integer -> List a -> List (List a)
export segment = (l, xs) => {
  t = length(xs)
  perfect = t % l == 0
  whole = toInteger(Math.floor(t / l))
  repeat = perfect ? whole : whole + 1
  return l < 1 ? [xs] : repeatWith((i) => slice(i * l, (i + 1) * l, xs), repeat)
}
