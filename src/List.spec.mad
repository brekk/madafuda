import List from "List"

import { report } from "Study"

import { cut, segment } from "@/List"



report(cut($, List.range(0, 20)), "cut", [#[4, #[[0, 1, 2, 3, 4], List.range(4, 20)]]])
report(
  segment($, List.range(0, 20)),
  "cut",
  [
    #[
      4,
      [
        [0, 1, 2, 3, 4],
        [4, 5, 6, 7, 8],
        [8, 9, 10, 11, 12],
        [12, 13, 14, 15, 16],
        [16, 17, 18, 19],
      ],
    ],
    #[
      3,
      [
        [0, 1, 2, 3],
        [3, 4, 5, 6],
        [6, 7, 8, 9],
        [9, 10, 11, 12],
        [12, 13, 14, 15],
        [15, 16, 17, 18],
        [18, 19],
      ],
    ],
    #[-1, [List.range(0, 20)]],
  ],
)
