import type { Maybe } from "Maybe"

import type { Card } from "@/Deck"

import { find, nth } from "List"
import { fromMaybe } from "Maybe"

import { Card } from "@/Deck"



export type Player = Player(String, List Card)

cardsPerPlayer :: Integer -> #[Integer, Integer]
export cardsPerPlayer = (i) => if (i == 2) {
  #[8, 8]
} else if (i == 3) {
  #[7, 6]
} else if (i == 4) {
  #[5, 8]
} else if (i == 5) {
  #[4, 8]
} else if (i == 6) {
  #[3, 12]
} else if (i == 7) {
  #[3, 6]
} else {
  #[-1, -1]
}

playerAtIndex :: Integer -> List Player -> Player
export playerAtIndex = (i, players) => pipe(
  nth(i),
  fromMaybe(Player("Nobody", [])),
)(players)

playerName :: Player -> String
export playerName = where {
  Player(name, _) =>
    name
}

getPlayerByName :: String -> List Player -> Maybe Player
export getPlayerByName = (name, players) => find((p) => playerName(p) == name, players)

nameOfPlayerAtIndex :: List Player -> Integer -> String
export nameOfPlayerAtIndex = (players, i) => pipe(
  playerAtIndex(i),
  playerName,
)(players)
