import type { Comparison } from "Compare"

import { EQ, GT, LT } from "Compare"
import { any, filter, sortBy } from "List"



export type Suit
  = Pine
  | Plum
  | Cherry
  | Wisteria
  | Iris
  | Peony
  | Clover
  | Grass
  | Chrysanthemum
  | Maple
  | Willow
  | Foxglove

// Hikari = 20
// Tane = 5
// Tanzaku = 10
// Kasu = 0
export type Value = Hikari | Tane | Tanzaku | Kasu
export type Card = Card(Suit, Value)

// derive Comparable Suit
// derive Comparable Value
// derive Comparable Card

instance Comparable Value {
  compare = compareValue
}

instance Comparable Card {
  compare = compareCards
}

export compareValue = (a, b) => where(#[a, b]) {
  #[Hikari, Hikari] =>
    EQ

  #[Hikari, _] =>
    GT

  #[Tanzaku, Tanzaku] =>
    EQ

  #[Tanzaku, _] =>
    GT

  #[Tane, Tane] =>
    EQ

  #[Tane, _] =>
    GT

  #[Kasu, Kasu] =>
    EQ

  _ =>
    LT
}

