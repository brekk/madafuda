    any(where { Card(_, suit2) => suit == suit2 }, cs)
}
*/

canMatch :: List Card -> Card -> Boolean
export canMatch = (cs, c) => where(c) {
  // the lightning / police can match any card
  Card(Willow, Kasu) =>
    true

  Card(a, suit) =>
    any(where { Card(b, suit2) => suit == suit2 && a != b }, cs)
}
cardInList :: List Card -> Card -> Boolean
export cardInList = (cs, c) => where(c) {
  Card(a, suit) =>
    any(where { Card(b, suit2) => suit == suit2 && a == b }, cs)
}

matchableCards :: List Card -> Card -> List Card
export matchableCards = (cs, c) => where(c) {
  Card(Willow, Kasu) =>
    cs

  Card(_, suit) =>
    filter(where { Card(_, suit2) => suit == suit2 }, cs)
}
