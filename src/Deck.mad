hasCard :: Card -> List Card -> Boolean
export hasCard = (c, cs) => any(
  (k) => where(#[c, k]) {
    #[Card(a, a2), Card(b, b2)] =>
      a == b && a2 == b2
  },
  cs,
)

getSuit :: Card -> Suit
export getSuit = where {
  Card(s, _) =>
    s
}

getValue :: Card -> Value
export getValue = where {
  Card(_, v) =>
    v
}

serializeSuit :: Card -> String
export serializeSuit = pipe(
  getSuit,
  toOrdinalMonth,
  show,
)

serializeValue :: Card -> String
export serializeValue = pipe(
  getValue,
  toPointValue,
  show,
)

serializeCard :: Card -> String
export serializeCard = (c) => serializeSuit(c) ++ "-" ++ serializeValue(c)


toPointValue :: Value -> Integer
export toPointValue = where {
  Hikari =>
    20

  Tanzaku =>
    10

  Tane =>
    5

  _ =>
    0
}

toOrdinalMonth :: Suit -> Integer
export toOrdinalMonth = where {
  Pine =>
    0

  Plum =>
    1

  Cherry =>
    2

  Wisteria =>
    3

  Iris =>
    4

  Peony =>
    5

  Clover =>
    6

  Grass =>
    7

  Chrysanthemum =>
    8

  Maple =>
    9

  Willow =>
    10

  Foxglove =>
    11
}

compareCards :: Card -> Card -> Comparison
export compareCards = (a, b) => where(#[a, b]) {
  #[Card(s1, v1), Card(s2, v2)] =>
    do {
      x = toOrdinalMonth(s1)
      x2 = toPointValue(v1)
      y = toOrdinalMonth(s2)
      y2 = toPointValue(v1)
      return if (x == y) {
        x2 == y2 ? EQ : x2 < y2 ? LT : GT
      } else {
        x > y ? GT : LT
      }
    }
}

sortCards :: List Card -> List Card
export sortCards = sortBy(compareCards)

pointCardsOnly :: List Card -> List Card
export pointCardsOnly = filter(
  where {
    Card(_, Kasu) =>
      false

    _ =>
      true
  },
)

/*
canMatchSuit :: List Card -> Card -> Boolean
export canMatchSuit = (cs, c) => where(c) {
