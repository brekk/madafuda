import { Just, Nothing } from "Maybe"

import { report } from "Study"

import { NAMED } from "@/Deck"
import { Player, cardsPerPlayer, getPlayerByName, nameOfPlayerAtIndex, playerName } from "@/Player"



report(
  cardsPerPlayer,
  "cardsPerPlayer",
  [
    #[1, #[-1, -1]],
    #[2, #[8, 8]],
    #[3, #[7, 6]],
    #[4, #[5, 8]],
    #[5, #[4, 8]],
    #[6, #[3, 12]],
    #[7, #[3, 6]],
    #[8, #[-1, -1]],
  ],
)

report(playerName, "playerName", [#[Player("Poisson", []), "Poisson"]])

report(
  getPlayerByName($, [Player("Brekk", [NAMED.sakura]), Player("Clive", [])]),
  "getPlayerByName",
  [#["Brekk", Just(Player("Brekk", [NAMED.sakura]))], #["Poisson", Nothing]],
)

report(
  nameOfPlayerAtIndex([Player("Brekk", [NAMED.sakura]), Player("Clive", [])]),
  "nameOfPlayerAtIndex",
  [#[0, Just("Brekk")], #[4, Nothing]],
)
